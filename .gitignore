config/*
!config/.gitkeep

# Gerados em cada ambiente pelo .devcontainer/preparar.sh e ligar.sh (segredos e URL do Codespace)
chatwoot/.env
dify/.env

# Dados dos containers (bancos, redis, chaves, uploads) e arquivos gerados pelo nginx do Dify
dify/volumes/*
!dify/volumes/myscale/
!dify/volumes/oceanbase/
!dify/volumes/opensearch/
dify/volumes/sandbox/*
!dify/volumes/sandbox/conf/
dify/nginx/conf.d/default.conf
